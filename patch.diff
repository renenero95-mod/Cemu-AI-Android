+				addressOfCurrentInstruction,
+				opcode,
+				primary,
+				xo,
+				rt,
+				ra,
+				rb,
+				rc
+			);
+
 			ppcImlGenContext.currentOutputSegment = nullptr;
 			return false;
 		}
