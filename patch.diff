+// Diagnostic wrapper: always logs every open request issued by the title together with its result.
+// (CoreinitFile logging only traces export calls and needs advanced PPC logging, so we log here directly.)
+FSCVirtualFile* fsc_open(const char* path, FSC_ACCESS_FLAG accessFlags, sint32* fscStatus, sint32 maxPriority)
+{
+	FSCVirtualFile* vf = fsc_openImpl(path, accessFlags, fscStatus, maxPriority);
+	cemuLog_log(LogType::Force, "FSC open: '{}' flags=0x{:x} -> {} (status {})", path ? path : "(null)", (uint32)accessFlags, vf ? "OK" : "FAILED", (sint32)*fscStatus);
+	return vf;
+}
