 bool FSCDeviceWUA_Mount(std::string_view mountPath, std::string_view destinationBaseDir, ZArchiveReader* archive, sint32 priority)
 {
+	cemuLog_log(LogType::Force, "CemuFixer build marker: fscDeviceWua.cpp compiled {} {} (safe_archive_read, WUA read diagnostics)", __DATE__, __TIME__);
