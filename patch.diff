@@ -1,6 +1,34 @@
 #include "Cafe/Filesystem/fsc.h"
 #include <zarchive/zarchivereader.h>
 
+// ZArchiveReader reads through the (Android SAF backed) file stream and may return fewer bytes than requested.
+// Keep reading from the advancing offset until the full range has been delivered, EOF is hit,
+// or no progress is made. Returns the number of bytes actually read.
+static uint32 safe_archive_read(ZArchiveReader* archive, ZArchiveNodeHandle node, uint32 offset, uint32 size, void* buffer)
+{
+	constexpr int MAX_CONSECUTIVE_EMPTY_READS = 3;
+	uint8* bufPtr = static_cast<uint8*>(buffer);
+	uint32 totalRead = 0;
+	int emptyReads = 0;
+	while (totalRead < size)
+	{
+		uint32 bytesRead = (uint32)archive->ReadFromFile(node, (uint64)offset + totalRead, (uint64)(size - totalRead), bufPtr + totalRead);
+		if (bytesRead == 0)
+		{
+			cemuLog_log(LogType::Force, "[WUA DIAG ZERO-READ] offset=0x{:x} requested=0x{:x} totalRead=0x{:x} remaining=0x{:x}",
+				offset, size, totalRead, size - totalRead);
+			if (++emptyReads >= MAX_CONSECUTIVE_EMPTY_READS)
+				break;
+			continue;
+		}
+		emptyReads = 0;
+		totalRead += bytesRead;
+	}
+	if (totalRead < size)
+		cemuLog_log(LogType::Force, "WUA: short read (requested 0x{:x}, got 0x{:x})", size, totalRead);
+	return totalRead;
+}
+
 class FSCDeviceWuaFileCtx : public FSCVirtualFile
 {
 	friend class fscDeviceWUAC;
@@ -54,10 +82,36 @@ public:
 		if (m_fscType != FSC_TYPE_FILE)
 			return 0;
 		cemu_assert(size < (2ULL * 1024 * 1024 * 1024)); // single read operation larger than 2GiB not supported
-		uint32 bytesLeft = fscDeviceWuaFile_getFileSize() - m_seek;
+		uint32 fileSize = fscDeviceWuaFile_getFileSize();
+		const uint32 seekBefore = m_seek;
+		cemuLog_log(LogType::Force,
+			"[WUA DIAG READ-BEGIN] ctx=0x{:x} archive=0x{:x} buffer=0x{:x} seek=0x{:x} request=0x{:x} fileSize=0x{:x}",
+			(uint64)(uintptr_t)this, (uint64)(uintptr_t)m_archive, (uint64)(uintptr_t)buffer,
+			seekBefore, size, fileSize);
+		if (m_seek >= fileSize)
+		{
+			cemuLog_log(LogType::Force, "[WUA DIAG READ-EOF] ctx=0x{:x} seek=0x{:x} fileSize=0x{:x}",
+				(uint64)(uintptr_t)this, m_seek, fileSize);
+			return 0;
+		}
+		uint32 bytesLeft = fileSize - m_seek;
 		uint32 bytesToRead = (std::min)(bytesLeft, (uint32)size);
-		uint32 bytesSuccessfullyRead = (uint32)m_archive->ReadFromFile(m_nodeHandle, m_seek, bytesToRead, buffer);
+		uint32 bytesSuccessfullyRead = safe_archive_read(m_archive, m_nodeHandle, m_seek, bytesToRead, buffer);
+		if (bytesSuccessfullyRead >= 4096)
+		{
+			// CemuFixer diagnostics: detect "successful" reads that deliver zero-filled data
+			const uint8* data = static_cast<const uint8*>(buffer);
+			uint32 zeroBytes = 0;
+			for (uint32 i = 0; i < bytesSuccessfullyRead; i++)
+				zeroBytes += (data[i] == 0);
+			cemuLog_log(LogType::Force, "WUA read: seek=0x{:x} size=0x{:x} got=0x{:x} zeroBytes=0x{:x} first8={:02x}{:02x}{:02x}{:02x}{:02x}{:02x}{:02x}{:02x}",
+				m_seek, (uint32)size, bytesSuccessfullyRead, zeroBytes, data[0], data[1], data[2], data[3], data[4], data[5], data[6], data[7]);
+		}
 		m_seek += bytesSuccessfullyRead;
+		cemuLog_log(LogType::Force,
+			"[WUA DIAG READ-END] ctx=0x{:x} seekBefore=0x{:x} requested=0x{:x} bounded=0x{:x} got=0x{:x} seekAfter=0x{:x} short={}",
+			(uint64)(uintptr_t)this, seekBefore, size, bytesToRead, bytesSuccessfullyRead, m_seek,
+			bytesSuccessfullyRead != bytesToRead);
 		return bytesSuccessfullyRead;
 	}
 
@@ -65,15 +119,23 @@ public:
 	{
 		if (m_fscType != FSC_TYPE_FILE)
 			return;
+		const uint32 oldSeek = this->m_seek;
+		cemuLog_log(LogType::Force, "[WUA DIAG SEEK-BEGIN] ctx=0x{:x} old=0x{:x} requested=0x{:x}",
+			(uint64)(uintptr_t)this, oldSeek, seek);
