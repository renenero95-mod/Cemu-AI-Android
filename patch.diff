+			// the existing helper rather than dereferencing guest memory again.
+			const uint32 opcode = PPCRecompiler_getPreviousInstruction(&ppcImlGenContext);
+			const uint32 primaryOpcode = opcode >> 26;
+			const uint32 extendedOpcode = (opcode >> 1) & 0x3FF;
+			cemuLog_log(LogType::Force,
+				"[PPCREC UNSUPPORTED] PC=0x{:08x} opcode=0x{:08x} primary={} xo={} rt={} ra={} rb={} rc={}",
+				addressOfCurrentInstruction, opcode, primaryOpcode,
+				extendedOpcode, (opcode >> 21) & 0x1F,
+				(opcode >> 16) & 0x1F, (opcode >> 11) & 0x1F, opcode & 1);
 			ppcImlGenContext.currentOutputSegment = nullptr;
 			return false;
 		}
