 				channels[3] = 0;
 				channels[4] = g_snd_user_data.pan_values[spandiff];
-				channels[5] = g_snd_user_data.pan_values[control->span];
+				channels[5] = g_snd_user_data.pan_values[span];
 			}
 			else
 			{
-				uint32 pan = 0x7F;
