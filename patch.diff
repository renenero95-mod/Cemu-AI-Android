+#include "FileStream_saf.h"
+#include "FilesystemAndroid.h"
+
+FileStreamSAF* FileStreamSAF::OpenFile(const fs::path& path)
+{
+	auto fileStream = new FileStreamSAF(path);
+	if (fileStream->m_isValid)
+	{
+		return fileStream;
+	}
+
+	delete fileStream;
+	return nullptr;
+}
+
+void FileStreamSAF::SetPosition(uint64 pos)
+{
+	if (!m_isValid)
+		return;
+	// seekg() does not clear failbit; a previous failed/short read would otherwise make the stream permanently dead
+	m_stream.clear();
+	m_stream.seekg((std::streampos)pos);
+}
+
+uint64 FileStreamSAF::GetSize()
+{
+	cemu_assert(m_isValid);
+	m_stream.clear();
+	auto currentPos = m_stream.tellg();
+	m_stream.seekg(0, std::ios::end);
+	auto fileSize = m_stream.tellg();
+	m_stream.clear();
+	m_stream.seekg(currentPos, std::ios::beg);
+	if (fileSize < 0)
+	{
+		cemuLog_log(LogType::Force, "FileStreamSAF::GetSize: tellg() failed");
+		return 0;
+	}
+	uint64 fs = (uint64)fileSize;
+	return fs;
+}
+
+bool FileStreamSAF::SetEndOfFile()
+{
+	return true;
+}
+
+void FileStreamSAF::extract(std::vector<uint8>& data)
+{
+	if (!m_isValid)
+		return;
+	uint64 fileSize = GetSize();
+	SetPosition(0);
+	data.resize(fileSize);
+	readData(data.data(), fileSize);
+}
+
+uint32 FileStreamSAF::readData(void* data, uint32 length)
+{
+	if (!m_isValid || length == 0)
+		return 0;
+	// std::istream::read() sets eofbit|failbit on any short read and every later read then returns 0 bytes
+	// (leaving the caller's buffer untouched) until clear() is called. SAF/content:// descriptors can return
+	// short reads, so: clear the state before each attempt and keep reading until the request is satisfied,
+	// a real EOF is reached (0 bytes + eofbit), or no progress is made several times in a row.
+	constexpr int MAX_CONSECUTIVE_EMPTY_READS = 3;
+	uint8* dst = static_cast<uint8*>(data);
+	uint32 totalRead = 0;
+	int emptyReads = 0;
+	while (totalRead < length)
+	{
+		m_stream.clear();
+		m_stream.read((char*)dst + totalRead, length - totalRead);
+		std::streamsize n = m_stream.gcount();
+		if (n > 0)
+		{
+			totalRead += (uint32)n;
+			emptyReads = 0;
+			continue;
+		}
+		if (m_stream.eof())
+			break; // real end of file
+		if (++emptyReads >= MAX_CONSECUTIVE_EMPTY_READS)
+			break;
+	}
+	if (totalRead < length)
+		cemuLog_log(LogType::Force, "FileStreamSAF::readData: short read (requested 0x{:x}, got 0x{:x})", length, totalRead);
+	m_stream.clear(); // leave the stream usable for the next operation
+	return totalRead;
+}
+
+bool FileStreamSAF::readU64(uint64& v)
+{
+	return readData(&v, sizeof(uint64)) == sizeof(uint64);
+}
+
+bool FileStreamSAF::readU32(uint32& v)
+{
+	return readData(&v, sizeof(uint32)) == sizeof(uint32);
+}
+
+bool FileStreamSAF::readU8(uint8& v)
+{
+	return readData(&v, sizeof(uint8)) == sizeof(uint8);
+}
+
+bool FileStreamSAF::readLine(std::string& line)
+{
+	line.clear();
+	uint8 c;
+	bool isEOF = true;
+	while (readU8(c))
+	{
+		isEOF = false;
+		if (c == '\r')
+			continue;
+		if (c == '\n')
+			break;
+		line.push_back((char)c);
+	}
+	return !isEOF;
+}
+
+sint32 FileStreamSAF::writeData(const void* data, sint32 length)
+{
+	throw std::runtime_error("write operation not supported");
+}
+
+void FileStreamSAF::writeU64(uint64 v)
+{
+	throw std::runtime_error("write operation not supported");
+}
+
+void FileStreamSAF::writeU32(uint32 v)
+{
+	throw std::runtime_error("write operation not supported");
+}
+
+void FileStreamSAF::writeU8(uint8 v)
+{
+	throw std::runtime_error("write operation not supported");
+}
+
+void FileStreamSAF::writeStringFmt(const char* format, ...)
+{
+	throw std::runtime_error("write operation not supported");
+}
+
+void FileStreamSAF::writeString(const char* str)
+{
+	throw std::runtime_error("write operation not supported");
+}
+
