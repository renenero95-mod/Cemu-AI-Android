@@ -609,6 +618,8 @@ uint32 fsc_readFile(FSCVirtualFile* fscFile, void* buffer, uint32 size)
 	fscEnter();
 	uint32 fscStatus = fscFile->fscReadData(buffer, size);
 	fscLeave();
+	if (fscStatus != size)
+		cemuLog_log(LogType::Force, "FSC read: requested 0x{:x} bytes but got 0x{:x}", size, fscStatus);
 	return fscStatus;
 }
 
