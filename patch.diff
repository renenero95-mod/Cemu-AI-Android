+			{
+				const uint32 rt = (instruction >> 21) & 0x1F;
+				const uint32 ra = (instruction >> 16) & 0x1F;
+				const sint16 displacement = (sint16)(instruction & 0xFFFF);
+
+				cemuLog_log(LogType::Force,
+					"[PPC READ NULL] EA=0x{:08x} IP=0x{:08x} LR=0x{:08x} "
+					"instruction=0x{:08x} LWZ RT=r{} RA=r{} displacement={}",
+					address, ip, (uint32)hCPU->spr.LR,
+					instruction, rt, ra, displacement);
+			}
+			else
+			{
+				cemuLog_log(LogType::Force,
+					"[PPC READ NULL] EA=0x{:08x} IP=0x{:08x} LR=0x{:08x} "
+					"instruction=0x{:08x} opcode={}",
+					address, ip, (uint32)hCPU->spr.LR,
+					instruction, opcode);
+			}
+		}
+
+		uint32 v = *(uint32*)ptr;
 		return CPU_swapEndianU32(v);
 	}
 
