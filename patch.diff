+class AtomicRWLock {
+	std::atomic<int32_t> m_lock{0};
+public:
+	void LockWrite() {
+		int32 expected = 0;
+		while (!m_lock.compare_exchange_weak(expected, -1, std::memory_order_relaxed, std::memory_order_relaxed)) {
+			expected = 0;
+			sched_yield();
+		}
+	}
+	void UnlockWrite() {
+		m_lock.store(0, std::memory_order_relaxed);
+	}
+};
