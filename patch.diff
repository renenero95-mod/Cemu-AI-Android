 	{
 		uint64 v = *(uint64*)(memory_getPointerFromVirtualOffset(address));
 		return CPU_swapEndianU64(v);
-	}
-
-	inline static uint32 ppcMem_readDataU32(PPCInterpreter_t* hCPU, uint32 address)
+		inline static uint32 ppcMem_readDataU32(PPCInterpreter_t* hCPU, uint32 address)
 	{
-		uint32 v = *(uint32*)(memory_getPointerFromVirtualOffset(address));
+		auto logReadFault = [&]()
+		{
+			const uint32 ip = hCPU->instructionPointer;
+			const uint32 lr = hCPU->spr.LR;
+
+			if (memory_isValidRange(ip, sizeof(uint32)))
+			{
+				const uint32 instruction = memory_readCodeU32(hCPU, ip);
+				const uint32 primaryOpcode = instruction >> 26;
+
+				if (primaryOpcode == 32) // LWZ
+				{
+					const uint32 rt = (instruction >> 21) & 0x1F;
+					const uint32 ra = (instruction >> 16) & 0x1F;
+					const sint16 displacement = (sint16)(instruction & 0xFFFF);
+
+					cemuLog_log(LogType::Force,
+						"[PPC READ FAULT] LWZ"
+						" EA=0x{:08x}"
+						" IP=0x{:08x}"
+						" LR=0x{:08x}"
+						" instruction=0x{:08x}"
+						" RT=r{}"
+						" RA=r{}"
+						" displacement={}",
+						address, ip, lr, instruction,
+						rt, ra, displacement);
+				}
+				else
+				{
+					cemuLog_log(LogType::Force,
+						"[PPC READ FAULT] Non-LWZ"
+						" EA=0x{:08x}"
+						" IP=0x{:08x}"
+						" LR=0x{:08x}"
+						" instruction=0x{:08x}"
+						" opcode={}",
+						address, ip, lr, instruction, primaryOpcode);
+				}
+			}
+			else
+			{
+				cemuLog_log(LogType::Force,
+					"[PPC READ FAULT] EA=0x{:08x}"
+					" IP=0x{:08x} (instruction address invalid)"
+					" LR=0x{:08x}",
+					address, ip, lr);
+			}
+		};
+
+		if (!memory_isValidRange(address, sizeof(uint32)))
+		{
+			logReadFault();
+			PPCState_t_dataAccessFault(hCPU, address);
+			return 0;
+		}
+
+		void* ptr = memory_getPointerFromVirtualOffset(address);
+		if (!ptr)
+		{
+			logReadFault();
+			PPCState_t_dataAccessFault(hCPU, address);
+			return 0;
+		}
+
+		uint32 v;
+		std::memcpy(&v, ptr, sizeof(uint32));
 		return CPU_swapEndianU32(v);
 	}
 
