+	inline static uint64 ppcMem_readDataU64(PPCInterpreter_t* hCPU, uint32 address)
+	{
+		uint64 v = *(uint64*)(memory_getPointerFromVirtualOffset(address));
+		return CPU_swapEndianU64(v);
+	}
+
 	inline static uint32 ppcMem_readDataU32(PPCInterpreter_t* hCPU, uint32 address)
 	{
-		uint32 v = *(uint32*)(memory_getPointerFromVirtualOffset(address));
+		if (!memory_isValidRange(address, sizeof(uint32)))
+		{
+			uint32 ip = hCPU->instructionPointer;
+			uint32 instruction = 0;
+
+			if (memory_isValidRange(ip, sizeof(uint32)))
+				instruction = memory_readCodeU32(hCPU, ip);
+
+			uint32 opcode = instruction >> 26;
+
+			if (opcode == 32) // LWZ
+			{
+				uint32 rt = (instruction >> 21) & 0x1F;
+				uint32 ra = (instruction >> 16) & 0x1F;
+				sint16 displacement = (sint16)(instruction & 0xFFFF);
+
+				cemuLog_log(LogType::Force,
+					"[PPC READ FAULT] LWZ EA=0x{:08x} IP=0x{:08x} LR=0x{:08x} instruction=0x{:08x} RT=r{} RA=r{} displacement={}",
+					address,
+					ip,
+					(uint32)hCPU->spr.LR,
+					instruction,
+					rt,
+					ra,
+					displacement);
+			}
+			else
+			{
+				cemuLog_log(LogType::Force,
+					"[PPC READ FAULT] EA=0x{:08x} IP=0x{:08x} LR=0x{:08x} instruction=0x{:08x} opcode={}",
+					address,
+					ip,
+					(uint32)hCPU->spr.LR,
+					instruction,
+					opcode);
+			}
+
+			PPCState_t_dataAccessFault(hCPU, address);
+			return 0;
+		}
+
+		void* ptr = memory_getPointerFromVirtualOffset(address);
+		if (ptr == nullptr)
+		{
+			cemuLog_log(LogType::Force,
+				"[PPC READ FAULT] NULL POINTER EA=0x{:08x} IP=0x{:08x} LR=0x{:08x}",
+				address,
+				hCPU->instructionPointer,
+				(uint32)hCPU->spr.LR);
+
+			PPCState_t_dataAccessFault(hCPU, address);
+			return 0;
+		}
+
+		uint32 v;
+		std::memcpy(&v, ptr, sizeof(uint32));
 		return CPU_swapEndianU32(v);
 	}
 
