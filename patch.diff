diff --git a/src/util/CemuProfiling.h b/src/util/CemuProfiling.h
new file mode 100644
index 0000000..1111111
index e69de29..1d115a4 100644
--- /dev/null
+++ b/src/util/CemuProfiling.h
@@ -0,0 +1,96 @@
+#pragma once
+
+#ifndef CEMU_PROFILING
+#define CEMU_PROFILING 1
+#endif
+
+#if CEMU_PROFILING
+#include <atomic>
+#include <chrono>
+#include <cstdint>
+
+namespace CemuProfiling
+{
+    using Clock = std::chrono::steady_clock;
+
+    struct Counter
+    {
+        std::atomic<uint64_t> calls{ 0 };
+        std::atomic<uint64_t> items{ 0 };
+        std::atomic<uint64_t> nanoseconds{ 0 };
+
+        void Record(uint64_t itemCount, uint64_t elapsedNs)
+        {
+            calls.fetch_add(1, std::memory_order_relaxed);
+            items.fetch_add(itemCount, std::memory_order_relaxed);
+            nanoseconds.fetch_add(elapsedNs, std::memory_order_relaxed);
+        }
+
+        void AddItems(uint64_t itemCount = 1)
+        {
+            items.fetch_add(itemCount, std::memory_order_relaxed);
+        }
+
+        struct Snapshot
+        {
+            uint64_t calls;
+            uint64_t items;
+            uint64_t nanoseconds;
+        };
+
+        Snapshot TakeSnapshot()
+        {
+            return {
+                calls.exchange(0, std::memory_order_relaxed),
+                items.exchange(0, std::memory_order_relaxed),
+                nanoseconds.exchange(0, std::memory_order_relaxed)
+            };
+        }
+    };
+
+    inline Counter& Interpreter()       { static Counter c; return c; }
+    inline Counter& HLE()               { static Counter c; return c; }
+    inline Counter& Recompiler()        { static Counter c; return c; }
+    inline Counter& FiberTimeslice()    { static Counter c; return c; }
+    inline Counter& Drawcalls()         { static Counter c; return c; }
+    inline Counter& PipelineChanges()   { static Counter c; return c; }
+    inline Counter& ThreadSleepWait()   { static Counter c; return c; }
+    inline Counter& ThreadJoinWait()    { static Counter c; return c; }
+    inline Counter& ThreadQueueWait()   { static Counter c; return c; }
+    inline Counter& VulkanSubmit()      { static Counter c; return c; }
+    inline Counter& VulkanPresent()     { static Counter c; return c; }
+    inline Counter& VulkanFenceWait()   { static Counter c; return c; }
+    inline Counter& AudioUpdate()       { static Counter c; return c; }
+    inline Counter& AudioMutexWait()    { static Counter c; return c; }
+
+    class ScopedTimer
+    {
+    public:
+        explicit ScopedTimer(Counter& counter, uint64_t itemCount = 1)
+            : m_counter(counter), m_itemCount(itemCount), m_start(Clock::now())
+        {
+        }
+
+        ~ScopedTimer()
+        {
+            const auto elapsed = std::chrono::duration_cast<std::chrono::nanoseconds>(
+                Clock::now() - m_start).count();
+            m_counter.Record(m_itemCount, static_cast<uint64_t>(elapsed));
+        }
+
+        ScopedTimer(const ScopedTimer&) = delete;
+        ScopedTimer& operator=(const ScopedTimer&) = delete;
+
+    private:
+        Counter& m_counter;
+        uint64_t m_itemCount;
+        Clock::time_point m_start;
+    };
+
+    inline uint64_t ElapsedNs(Clock::time_point start)
+    {
+        return static_cast<uint64_t>(
+            std::chrono::duration_cast<std::chrono::nanoseconds>(Clock::now() - start).count());
+    }
+}
+#endif
diff --git a/src/util/CemuThreadWatchdog.h b/src/util/CemuThreadWatchdog.h
new file mode 100644
index 0000000..1111111
index e69de29..6470702 100644
--- /dev/null
+++ b/src/util/CemuThreadWatchdog.h
@@ -0,0 +1,110 @@
+#pragma once
+
+#ifndef CEMU_THREAD_WATCHDOG
+#define CEMU_THREAD_WATCHDOG 1
+#endif
+
+#if CEMU_THREAD_WATCHDOG
+
+#include <atomic>
+#include <chrono>
+#include <cstdint>
+#include <thread>
+
+namespace CemuWatchdog
+{
+    using Clock = std::chrono::steady_clock;
+
+    enum ThreadId : uint32_t
+    {
+        Main = 0,
+        Renderer = 1,
+        Recompiler = 2
+    };
+
+    enum Phase : uint32_t
+    {
+        Loop = 0,
+        Sleep = 1,
+        QueueWait = 2,
+        FenceWait = 3,
+        Present = 4,
+        Compile = 5
+    };
+
+    struct State
+    {
+        std::atomic<uint64_t> lastNs{ 0 };
+        std::atomic<uint64_t> ticks{ 0 };
+        std::atomic<uint32_t> phase{ Loop };
+    };
+
+    inline State& GetState(ThreadId id)
+    {
+        static State states[3];
+        return states[static_cast<uint32_t>(id)];
+    }
+
+    inline uint64_t NowNs()
+    {
+        return static_cast<uint64_t>(
+            std::chrono::duration_cast<std::chrono::nanoseconds>(
+                Clock::now().time_since_epoch()).count());
+    }
+
+    inline void Touch(ThreadId id, Phase phase)
+    {
+        State& s = GetState(id);
+        s.phase.store(phase, std::memory_order_relaxed);
+        s.lastNs.store(NowNs(), std::memory_order_relaxed);
+        s.ticks.fetch_add(1, std::memory_order_relaxed);
+    }
+
+    inline void Start()
+    {
+        static std::atomic<bool> started{ false };
+
+        if (started.exchange(true, std::memory_order_relaxed))
+            return;
+
+        const uint64_t now = NowNs();
+
+        for (uint32_t i = 0; i < 3; ++i)
+            GetState(static_cast<ThreadId>(i)).lastNs.store(
+                now, std::memory_order_relaxed);
+
+        std::thread([]()
+        {
+            for (;;)
+            {
+                std::this_thread::sleep_for(std::chrono::seconds(2));
+
+                const uint64_t now = NowNs();
+
+                for (uint32_t i = 0; i < 3; ++i)
+                {
+                    const State& s =
+                        GetState(static_cast<ThreadId>(i));
+
+                    const uint64_t last =
+                        s.lastNs.load(std::memory_order_relaxed);
+
+                    const uint64_t ageMs =
+                        last == 0 ? 0 : (now - last) / 1000000ULL;
+
+                    const uint64_t ticks =
+                        s.ticks.load(std::memory_order_relaxed);
+
+                    const uint32_t phase =
+                        s.phase.load(std::memory_order_relaxed);
+
+                    cemuLog_log(LogType::Force,
+                        "[THREAD WATCH] id={} phase={} age={}ms ticks={}",
+                        i, phase, ageMs, ticks);
+                }
+            }
+        }).detach();
+    }
+}
+
+#endif

